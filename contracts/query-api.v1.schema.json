{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "t-gate/query-api.v1.schema.json",
  "title": "T-Guard query API v1: GET /api/messages response",
  "type": "object",
  "required": ["schema", "version", "messages"],
  "additionalProperties": false,
  "properties": {
    "schema": { "const": "t-gate.query-api" },
    "version": { "const": 1 },
    "messages": { "type": "array", "items": { "$ref": "#/$defs/message" } }
  },
  "$defs": {
    "message": {
      "type": "object",
      "required": ["id", "from", "body", "receivedAt", "action", "reason", "verdict"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string" },
        "from": {
          "type": "object",
          "required": ["participantId", "display"],
          "additionalProperties": false,
          "properties": { "participantId": { "type": "string" }, "display": { "type": "string" } }
        },
        "body": { "type": "string" },
        "receivedAt": { "type": "string", "format": "date-time" },
        "action": { "enum": ["pending", "delivered", "blocked"] },
        "reason": { "enum": ["model_verdict", "classifier_unavailable", "not_classified", "sender_blocked", "override", null] },
        "verdict": { "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/verdict" }] },
        "kind": {
          "description": "What was sent. Optional for older v1 producers; absent means \"text\".",
          "enum": ["text", "link", "attachment", "reaction", "contact", "album"]
        },
        "conversation": {
          "description": "The iMessage chat it arrived in. Optional; absent means a DM.",
          "type": "object",
          "required": ["id", "type"],
          "additionalProperties": false,
          "properties": { "id": { "type": "string" }, "type": { "enum": ["dm", "group"] } }
        },
        "attachments": {
          "description": "Attachment metadata only (no bytes or URLs).",
          "type": "array",
          "items": {
            "type": "object",
            "required": ["name", "mimeType", "size"],
            "additionalProperties": false,
            "properties": {
              "name": { "type": ["string", "null"] },
              "mimeType": { "type": ["string", "null"] },
              "size": { "type": ["integer", "null"], "minimum": 0 }
            }
          }
        },
        "reaction": {
          "oneOf": [
            { "type": "null" },
            {
              "type": "object",
              "required": ["emoji", "targetPreview"],
              "additionalProperties": false,
              "properties": { "emoji": { "type": "string" }, "targetPreview": { "type": ["string", "null"] } }
            }
          ]
        },
        "contact": {
          "oneOf": [
            { "type": "null" },
            {
              "type": "object",
              "required": ["name", "phones"],
              "additionalProperties": false,
              "properties": {
                "name": { "type": ["string", "null"] },
                "phones": { "description": "Masked, like from.display", "type": "array", "items": { "type": "string" } }
              }
            }
          ]
        }
      }
    },
    "verdict": {
      "type": "object",
      "required": ["label", "score", "category", "model", "highlights"],
      "additionalProperties": false,
      "properties": {
        "label": { "enum": ["scam", "legit"] },
        "score": { "type": "number", "minimum": 0, "maximum": 1 },
        "category": { "type": ["string", "null"] },
        "model": { "type": "string" },
        "warning": { "enum": ["large_money_request"] },
        "review": { "type": "object", "required": ["decision", "reason", "model", "checks", "bankSource"], "additionalProperties": false, "properties": { "decision": { "enum": ["block", "deliver"] }, "reason": { "type": "string" }, "model": { "type": "string" }, "checks": { "type": "array", "items": { "type": "object", "required": ["check", "keyword", "found"], "additionalProperties": false, "properties": { "check": { "type": "string" }, "keyword": { "type": ["string", "null"] }, "found": { "type": "boolean" } } } }, "bankSource": { "enum": ["nessie", "mock", null] } } },
        "highlights": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["start", "end", "text", "weight"],
            "additionalProperties": false,
            "properties": {
              "start": { "type": "integer", "minimum": 0 },
              "end": { "type": "integer", "minimum": 0 },
              "text": { "type": "string" },
              "weight": { "type": "number" }
            }
          }
        }
      }
    }
  }
}
