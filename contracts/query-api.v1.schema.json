{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "t-gate/query-api.v1.schema.json",
  "title": "T-Gate query API v1: GET /api/messages response",
  "type": "object",
  "required": ["schema", "version", "messages"],
  "additionalProperties": false,
  "properties": {
    "schema": { "const": "t-gate.query-api" },
    "version": { "const": 1 },
    "messages": { "type": "array", "items": { "$ref": "#/$defs/message" } }
  },
  "$defs": {
    "message": {
      "type": "object",
      "required": ["id", "from", "body", "receivedAt", "action", "reason", "verdict"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string" },
        "from": {
          "type": "object",
          "required": ["participantId", "display"],
          "additionalProperties": false,
          "properties": {
            "participantId": { "type": "string" },
            "display": { "type": "string" }
          }
        },
        "body": { "type": "string" },
        "receivedAt": { "type": "string", "format": "date-time" },
        "action": { "enum": ["pending", "delivered", "blocked"] },
        "reason": { "enum": ["model_verdict", "classifier_unavailable", null] },
        "verdict": { "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/verdict" }] }
      }
    },
    "verdict": {
      "type": "object",
      "required": ["label", "score", "category", "model", "highlights"],
      "additionalProperties": false,
      "properties": {
        "label": { "enum": ["scam", "legit"] },
        "score": { "type": "number", "minimum": 0, "maximum": 1 },
        "category": { "type": ["string", "null"] },
        "model": { "type": "string" },
        "highlights": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["start", "end", "text", "weight"],
            "additionalProperties": false,
            "properties": {
              "start": { "type": "integer", "minimum": 0 },
              "end": { "type": "integer", "minimum": 0 },
              "text": { "type": "string" },
              "weight": { "type": "number" }
            }
          }
        }
      }
    }
  }
}
