{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://t-gate.example/contracts/voice-call-results.v1.schema.json",
  "title": "T-Gate voice call results query API v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "version", "calls"],
  "properties": {
    "schema": { "const": "t-gate.voice-call-results" },
    "version": { "const": 1 },
    "calls": {
      "type": "array",
      "items": { "$ref": "voice-call-result.v1.schema.json#/$defs/call" }
    }
  }
}
