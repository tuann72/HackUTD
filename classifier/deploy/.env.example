# Copy to deploy/.env on the server. Never commit the real file.
# Free HTTPS hostname for your server's IP: replace dots with dashes, e.g. 45.76.1.2 -> 45-76-1-2.sslip.io
# The classifier is served at this name, the gateway at gateway.<this name>.
TGATE_DOMAIN=45-76-1-2.sslip.io
# Long random secret; the gateway sends it as "Authorization: Bearer <token>". Make one: openssl rand -hex 32
CLASSIFIER_TOKEN=replace-me

# --- Gateway ---
# The Twilio account's auth token (Twilio console > Account info). Used to verify X-Twilio-Signature.
TWILIO_AUTH_TOKEN=replace-me
# Origins allowed to read GET /api/messages (the message UI), comma-separated.
CORS_ORIGINS=http://localhost:3000
# Block when the score is at or above this (TBD, tune on val).
BLOCK_THRESHOLD=0.5
# Uncomment to run the gateway with its keyword stub instead of the classifier (e.g. before a model exists).
# GATEWAY_CLASSIFIER_URL=
