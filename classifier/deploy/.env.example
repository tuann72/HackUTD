# Copy to deploy/.env on the server. Never commit the real file.
# Free HTTPS hostname for your server's IP: replace dots with dashes, e.g. 45.76.1.2 -> 45-76-1-2.sslip.io
TGATE_DOMAIN=45-76-1-2.sslip.io
# Long random secret; the gateway sends it as "Authorization: Bearer <token>". Make one: openssl rand -hex 32
CLASSIFIER_TOKEN=replace-me
