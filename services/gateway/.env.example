# Copy to .env and fill in. Never commit .env.
PORT=8787

# Photon webhook signing secret (whsec_... on Photon 2.0 / Beta), shown once by
# npm run photon:webhook -- register https://<host>/webhooks/photon --write-env
# (see DEPLOY.md step 6). The dev placeholder below
# matches the perpetrator simulator's default. Never commit the real one.
PHOTON_WEBHOOK_SECRET=dev-photon-webhook-secret-change-me

# Reject deliveries whose X-Spectrum-Timestamp is more than this many seconds from now.
SIGNATURE_TOLERANCE_SECONDS=300

# Only needed to register the webhook, not by the gateway itself.
# On Beta: a pho_prj_ id, and a pho_ask_ or pho_sk_ API key as the secret.
# PHOTON_PROJECT_ID=
# PHOTON_PROJECT_SECRET=

DB_PATH=./data/gateway.sqlite

# Empty = built-in keyword stub classifier. Set to the classifier service base URL
# (the gateway calls ${CLASSIFIER_URL}/classify).
CLASSIFIER_URL=
CLASSIFIER_TOKEN=
CLASSIFIER_TIMEOUT_MS=2500

# Block when verdict.score >= BLOCK_THRESHOLD.
BLOCK_THRESHOLD=0.5

# Comma-separated origins allowed to GET /api/*.
CORS_ORIGINS=http://localhost:3000

# Debug tools (POST /debug/reset). Off unless GATEWAY_DEBUG=1, and then DEBUG_TOKEN is required.
GATEWAY_DEBUG=0
DEBUG_TOKEN=

# Admin routes: POST /admin/messages/restore ("Not a scam" for one message, used by npm run message:restore).
# Off unless set. At least 16 chars: openssl rand -hex 24. The web app never calls admin routes.
ADMIN_TOKEN=

# Sender blocklist and scam fingerprints (docs/features/sender-blocklist.md). PARKED.
# off (default, Tuan 2026-11-08): block the message, not the sender. No blocklist calls, no Atlas connection,
# and the settings below are ignored. on: block known scam senders without the model.
SENDER_BLOCKLIST=off
# MongoDB Atlas connection string (Atlas > Connect > Drivers). Empty = in-process blocklist, lost on restart.
MONGODB_URI=
MONGODB_DB=tgate
# Optional DNS servers for Node's lookups, comma-separated IPs. Set this if Atlas fails with
# "querySrv ECONNREFUSED" (Node got a DNS server that doesn't answer SRV lookups), e.g. 1.1.1.1,8.8.8.8
DNS_SERVERS=
# HMAC key for fingerprints, at least 32 chars: openssl rand -hex 32. Required with MONGODB_URI.
# Changing it orphans every stored fingerprint. Never commit it.
FINGERPRINT_SECRET=
# Blocklist a sender after this many scam messages, or one at or above SENDER_BLOCK_SCORE (TBD, tune later).
SENDER_BLOCK_STRIKES=3
SENDER_BLOCK_SCORE=0.95
# Blocks expire after this many days.
SENDER_BLOCK_TTL_DAYS=7
