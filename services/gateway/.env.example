# Copy to .env and fill in. Never commit .env.
PORT=8787

# Twilio auth token used to verify X-Twilio-Signature.
# The dev placeholder below matches the perpetrator simulator's default.
# For the real victim number, set this to the Twilio account's auth token.
TWILIO_AUTH_TOKEN=dev-auth-token-change-me

# Exact public URL configured in the Twilio console (for example
# https://gateway.example.com/twilio/sms or a tunnel URL). Leave empty in local
# dev; the gateway then validates against the URL it was called on.
PUBLIC_WEBHOOK_URL=

DB_PATH=./data/gateway.sqlite

# Empty = built-in keyword stub classifier. Set to the classifier service base URL
# (the gateway calls ${CLASSIFIER_URL}/classify).
CLASSIFIER_URL=
CLASSIFIER_TOKEN=
CLASSIFIER_TIMEOUT_MS=2500

# Block when verdict.score >= BLOCK_THRESHOLD.
BLOCK_THRESHOLD=0.5

# Comma-separated origins allowed to GET /api/*.
CORS_ORIGINS=http://localhost:3000

# Debug tools (POST /debug/reset). Off unless GATEWAY_DEBUG=1, and then DEBUG_TOKEN is required.
GATEWAY_DEBUG=0
DEBUG_TOKEN=
