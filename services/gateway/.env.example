# Copy to .env and fill in. Never commit .env.
PORT=8787

# Photon (Spectrum) webhook signing secret, shown once when you register the webhook
# (see docs/features/photon-imessage.md, "Webhook setup"). The dev placeholder below
# matches the perpetrator simulator's default. Never commit the real one.
PHOTON_WEBHOOK_SECRET=dev-photon-webhook-secret-change-me

# Reject deliveries whose X-Spectrum-Timestamp is more than this many seconds from now.
SIGNATURE_TOLERANCE_SECONDS=300

# Only needed to register the webhook (curl in the plan), not by the gateway itself.
# PHOTON_PROJECT_ID=
# PHOTON_PROJECT_SECRET=

DB_PATH=./data/gateway.sqlite

# Empty = built-in keyword stub classifier. Set to the classifier service base URL
# (the gateway calls ${CLASSIFIER_URL}/classify).
CLASSIFIER_URL=
CLASSIFIER_TOKEN=
CLASSIFIER_TIMEOUT_MS=2500

# Block when verdict.score >= BLOCK_THRESHOLD.
BLOCK_THRESHOLD=0.5

# Comma-separated origins allowed to GET /api/*.
CORS_ORIGINS=http://localhost:3000

# Debug tools (POST /debug/reset). Off unless GATEWAY_DEBUG=1, and then DEBUG_TOKEN is required.
GATEWAY_DEBUG=0
DEBUG_TOKEN=

# Sender blocklist and scam fingerprints (docs/features/sender-blocklist.md).
# MongoDB Atlas connection string (Atlas > Connect > Drivers). Empty = in-process blocklist, lost on restart.
MONGODB_URI=
MONGODB_DB=tgate
# HMAC key for fingerprints, at least 32 chars: openssl rand -hex 32. Required with MONGODB_URI.
# Changing it orphans every stored fingerprint. Never commit it.
FINGERPRINT_SECRET=
# Blocklist a sender after this many scam messages, or one at or above SENDER_BLOCK_SCORE (TBD, tune later).
SENDER_BLOCK_STRIKES=3
SENDER_BLOCK_SCORE=0.95
# Blocks expire after this many days.
SENDER_BLOCK_TTL_DAYS=7
