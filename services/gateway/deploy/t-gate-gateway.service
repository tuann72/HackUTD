# Installed to /etc/systemd/system/ by bootstrap.sh.
[Unit]
Description=T-Gate interception gateway (Photon iMessage webhook + query API)
After=network-online.target
Wants=network-online.target

[Service]
User=tgate
Group=tgate
WorkingDirectory=/opt/t-gate/HackUTD/services/gateway
# npm start loads .env itself (--env-file-if-exists=.env), so no EnvironmentFile is needed.
ExecStart=/usr/bin/npm start
Restart=always
RestartSec=2
Environment=NODE_ENV=production
# Hardening: the service only writes its SQLite file under services/gateway/data.
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=true

[Install]
WantedBy=multi-user.target
