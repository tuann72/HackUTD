# Local development only: copy to .env and fill in the LiveKit Cloud credentials.
# LiveKit Cloud agent deployments inject these three variables automatically.
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=replace-me
LIVEKIT_API_SECRET=replace-me

# Capture is intentionally off by default. Set true only for a consented test call.
VOICE_GUARD_CAPTURE_ENABLED=false

# Optional until the classifier is available. If set, the service requires a bearer token.
# The service posts only {messageId: <opaque UUID>, text: <transcript>} to /classify.
CLASSIFIER_URL=
CLASSIFIER_TOKEN=
CLASSIFIER_TIMEOUT_MS=10000

# Optional result upload after classification. Use localhost for local development and HTTPS otherwise.
# Vercel only accepts writes when its
# matching VOICE_GUARD_RESULTS_INGEST_TOKEN, view token, and explicit result TTL are configured.
VOICE_GUARD_RESULTS_URL=
VOICE_GUARD_RESULTS_INGEST_TOKEN=
