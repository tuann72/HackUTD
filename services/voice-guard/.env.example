# Local development only: copy to .env and fill in the LiveKit Cloud credentials.
# LiveKit Cloud agent deployments inject these three variables automatically.
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=replace-me
LIVEKIT_API_SECRET=replace-me

# Capture is intentionally off by default. Set true only for a consented test call.
VOICE_GUARD_CAPTURE_ENABLED=false

# Where the after-call transcript goes: the T-Guard gateway's Photon webhook, signed like the
# simulator does. Use http://localhost:8787/webhooks/photon locally and HTTPS otherwise.
# GATEWAY_WEBHOOK_SECRET is the gateway's PHOTON_WEBHOOK_SECRET. Leave both empty to transcribe only.
GATEWAY_WEBHOOK_URL=
GATEWAY_WEBHOOK_SECRET=
GATEWAY_TIMEOUT_MS=10000

# Victim line put in the webhook's space.phone. Defaults to the fictional +15555550100.
VOICE_GUARD_VICTIM_LINE=

# --- Live call (optional; leave empty and nothing below changes behavior) ---
# Dial the victim's real phone into the call. Both must be set together.
# LIVEKIT_SIP_OUTBOUND_TRUNK_ID is a LiveKit outbound SIP trunk (ST_...) that can call PSTN numbers.
VOICE_GUARD_VICTIM_PHONE=
LIVEKIT_SIP_OUTBOUND_TRUNK_ID=
# Caller ID the victim sees (must be a number the trunk may send); the trunk's number when empty.
VOICE_GUARD_CALLER_ID=
VOICE_GUARD_RING_SECONDS=30

# Live scoring and the whisper warning. Both must be set together.
# VOICE_SCORE_URL is https://<gateway-host>/voice/score; VOICE_SCORE_TOKEN is the gateway's VOICE_SCORE_TOKEN.
VOICE_SCORE_URL=
VOICE_SCORE_TOKEN=
VOICE_SCORE_INTERVAL_MS=5000
VOICE_SCORE_TIMEOUT_MS=4000
# What the victim hears, and the LiveKit Inference TTS model/voice that speaks it.
VOICE_GUARD_WHISPER_TEXT=
VOICE_GUARD_TTS_MODEL=cartesia/sonic-3
VOICE_GUARD_TTS_VOICE=
