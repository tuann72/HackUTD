# Copy to .env (git-ignored). Placeholders only; never commit real credentials.
# Webhook URL of the T-Gate gateway. Must match the URL the gateway uses to verify signatures, exactly.
GATEWAY_WEBHOOK_URL=http://localhost:8787/twilio/sms
# Auth token used to sign X-Twilio-Signature. Matches the gateway's dev default.
TWILIO_AUTH_TOKEN=dev-auth-token-change-me
# AccountSid sent in the form body (placeholder).
TWILIO_ACCOUNT_SID=AC00000000000000000000000000000000
# The protected victim number (the "To" field).
VICTIM_NUMBER=+15555550100
