# Copy to .env (git-ignored). Placeholders only; never commit real credentials.
# Webhook URL of the T-Guard gateway.
GATEWAY_WEBHOOK_URL=http://localhost:8787/webhooks/photon
# Signs X-Spectrum-Signature. Must equal the gateway's PHOTON_WEBHOOK_SECRET (dev default below).
PHOTON_WEBHOOK_SECRET=dev-photon-webhook-secret-change-me
# The protected victim line (space.phone in the payload).
VICTIM_NUMBER=+15555550100
