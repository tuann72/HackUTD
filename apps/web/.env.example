# Gateway base URL (no trailing slash). Unset = mock replay of the contract fixture.
# Public: anything NEXT_PUBLIC_ ships to the browser, so never put secrets here.
NEXT_PUBLIC_API_URL=

# --- Server-only: the Photon webhook at /webhooks/photon (Vercel backup to the VM gateway) ---
# Set these in Vercel > Project > Settings > Environment Variables, never with NEXT_PUBLIC_.
# To show what this site receives, set NEXT_PUBLIC_API_URL to this site's own URL.
# Signing secret printed by: npm run photon:webhook -- register https://<site>/webhooks/photon
PHOTON_WEBHOOK_SECRET=
# MongoDB Atlas. Required on Vercel (no disk); empty = in-memory, lost on every cold start.
MONGODB_URI=
MONGODB_DB=tgate
# Empty = built-in keyword stub classifier.
CLASSIFIER_URL=
CLASSIFIER_TOKEN=
CLASSIFIER_TIMEOUT_MS=2500
BLOCK_THRESHOLD=0.5

# --- Server-only: the simulation panel (POST /api/simulate, docs/features/simulation-panel.md) ---
# The panel signs simulated iMessages here and sends them to the gateway. Unauthenticated, like Clear chats.
# Target webhook. Empty = ${NEXT_PUBLIC_API_URL}/webhooks/photon (the gateway the page reads).
SIM_WEBHOOK_URL=
# Must equal the target gateway's PHOTON_WEBHOOK_SECRET. Empty = this app's PHOTON_WEBHOOK_SECRET.
# With no URL or secret, the panel shows "Simulation is off".
SIM_WEBHOOK_SECRET=
# The victim line sent as space.phone (fictional +1555 numbers only).
SIM_VICTIM_NUMBER=+15555550100
